<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:background="@color/brand_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imgHeaderLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/peerlight_symbol"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_surface"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="LAN Ready"
            android:textColor="@color/brand_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Tabs Container -->
    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:layout_below="@id/headerBar">

        <!-- 1. HOME TAB -->
        <ScrollView
            android:id="@+id/viewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Zero-Recording Invariant Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECURITY INVARIANT"
                        android:textColor="@color/brand_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/zero_recording_guarantee"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="In-memory ring buffer (capacity 2). No video or screenshots written to disk."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Quick Direct Connect Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK DIRECT CONNECT"
                        android:textColor="@color/brand_blue"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etTargetIp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/brand_surface_elevated"
                        android:hint="Enter TV or PC IP (e.g. 192.168.254.104)"
                        android:paddingHorizontal="12dp"
                        android:text="192.168.254.104"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnQuickConnectTv"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/brand_blue"
                            android:text="Connect TV"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnQuickConnectPc"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/brand_surface_elevated"
                            android:text="Open Trackpad"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hardware Diagnostics & Specs Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/device_diagnostics"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDiagnostics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:text="Loading hardware diagnostics..."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Emergency Disconnect Button -->
                <Button
                    android:id="@+id/btnEmergencyDisconnect"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/emergency_red"
                    android:text="@string/emergency_disconnect"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- 2. DEVICES TAB -->
        <ScrollView
            android:id="@+id/viewDevices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCAL LAN DEVICES"
                    android:textColor="@color/brand_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Device 1: Xiaomi Mi TV -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xiaomi Mi TV (MiTV_MOSR2)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Google TV / Android TV 11 • 192.168.254.104:6466"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnDeviceConnectTv"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/brand_blue"
                        android:text="Launch TV Remote"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Device 2: Windows PC Endpoint -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Windows Desktop Endpoint"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Windows 11 (AMD64) • Port 8443 (TLS Encrypted)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnDeviceConnectPc"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="Open Trackpad Controller"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 3. REMOTE TAB (TV Remote & PC Trackpad) -->
        <ScrollView
            android:id="@+id/viewRemote"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTvStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google TV Remote: 192.168.254.104"
                    android:textColor="@color/brand_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- D-Pad Directional Grid -->
                <LinearLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/card_surface"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnTvUp"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="▲"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTvLeft"
                            android:layout_width="44dp"
                            android:layout_height="54dp"
                            android:backgroundTint="@color/brand_surface_elevated"
                            android:text="◀"
                            android:textColor="@color/text_primary" />

                        <Button
                            android:id="@+id/btnTvOk"
                            android:layout_width="68dp"
                            android:layout_height="54dp"
                            android:layout_marginHorizontal="6dp"
                            android:backgroundTint="@color/brand_blue"
                            android:text="OK"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnTvRight"
                            android:layout_width="44dp"
                            android:layout_height="54dp"
                            android:backgroundTint="@color/brand_surface_elevated"
                            android:text="▶"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnTvDown"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="▼"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Navigation Buttons Row (Back & Home) -->
                <LinearLayout
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTvBack"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="@string/btn_back"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnTvHome"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="@string/btn_home"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Media Buttons Row (Vol -, Play/Pause, Vol +) -->
                <LinearLayout
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTvVolDown"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="Vol -"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnTvPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="⏯"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnTvVolUp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="Vol +"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOpenFullTrackpad"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/brand_blue"
                    android:text="Switch to PC Fullscreen Trackpad"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- 4. SESSIONS & CONSENT TAB -->
        <ScrollView
            android:id="@+id/viewSessions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERMISSIONS &amp; SESSION STATE"
                    android:textColor="@color/brand_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- MediaProjection Screen Capture Consent Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screen Capture (MediaProjection)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Requires explicit user authorization. Live streaming only with zero disk recording."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnStartCapture"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/brand_blue"
                        android:text="@string/grant_consent"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <!-- Accessibility Service Consent Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remote Gesture Input (Accessibility)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/accessibility_status_disabled"
                        android:textColor="@color/status_warning"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnToggleAccessibility"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="@color/brand_surface_elevated"
                        android:text="Configure Accessibility Service"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 5. SETTINGS & ABOUT TAB -->
        <ScrollView
            android:id="@+id/viewSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/peerlight_symbol"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="v1.0.0 (Release Build) • RetsardCo"
                        android:textColor="@color/brand_cyan"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Cross-platform remote device viewing and control for local networks. Zero screen recording, no runtime ADB, mutual cryptographic pairing."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/brand_surface"
        app:itemIconTint="@color/brand_cyan"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
