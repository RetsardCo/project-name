<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Interactive Touch Surface mapping touch inputs to remote mouse pointer -->
    <View
        android:id="@+id/touchCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212" />

    <!-- Overlay Status Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#80000000"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvSessionInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Connected: Windows Host"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLeftClick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Left" />

        <Button
            android:id="@+id/btnRightClick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Right" />
    </LinearLayout>

    <!-- Prominent Emergency Disconnect Floating Button -->
    <Button
        android:id="@+id/btnControllerEmergencyDisconnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/emergency_red"
        android:text="@string/emergency_disconnect"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</RelativeLayout>
